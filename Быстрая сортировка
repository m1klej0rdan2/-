def quick_sort(arr):
    a = arr[:]                      # копия списка, чтобы не портить исходный
    if len(a) <= 1:                 # базовый случай: 0 или 1 элемент — уже отсортирован
        return a
    pivot = a[len(a) // 2]          # опорный элемент — берём средний
    left  = [x for x in a if x < pivot]   # всё, что меньше опорного
    mid   = [x for x in a if x == pivot]  # всё, что равно опорному
    right = [x for x in a if x > pivot]   # всё, что больше опорного
    # рекурсивно сортируем левую и правую части, середину оставляем как есть
    return quick_sort(left) + mid + quick_sort(right)

# --- ввод данных ---
s = input("Введите числа через пробел: ")   # читаем строку от пользователя
data = [int(x) for x in s.split()]          # разбиваем по пробелам и превращаем в числа

# --- вывод результата ---
print("Отсортир.: ", quick_sort(data))      # вызываем функцию и печатаем результат
