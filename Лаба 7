def shell_sort(arr):
    a = arr[:]              # копия списка, чтобы не менять исходный
    n = len(a)              # длина списка
    gap = n // 2            # начальный шаг = половина длины
    while gap > 0:          # цикл по шагам: n/2, n/4, ..., 1
        for i in range(gap, n):         # идём по элементам, начиная с позиции gap
            tmp = a[i]                  # запоминаем текущий элемент
            j = i                       # рабочий индекс
            # двигаемся назад шагами по gap, пока элемент слева больше tmp
            while j >= gap and a[j - gap] > tmp:
                a[j] = a[j - gap]       # сдвигаем больший элемент вправо
                j -= gap                # шагаем дальше влево на gap
            a[j] = tmp                  # вставляем tmp на нужное место
        gap //= 2                       # уменьшаем шаг вдвое
    return a                            # возвращаем отсортированный список

# --- ввод данных ---
s = input("Введите числа через пробел: ")   # читаем строку от пользователя
data = [int(x) for x in s.split()]          # разбиваем по пробелам и превращаем в числа

# --- вывод результата ---
print("Отсортир.: ", shell_sort(data))      # вызываем функцию и печатаем результат
