from abc import ABC, abstractmethod
from typing import Protocol
import json
import time
import functools


def log_calls(method):
    @functools.wraps(method)
    def wrapper(self, *args, **kwargs):
        print(f"{type(self).__name__}.{method.__name__} начинается")
        start = time.perf_counter()
        result = method(self, *args, **kwargs)
        elapsed = time.perf_counter() - start
        print(f"{type(self).__name__}.{method.__name__} завершён за {elapsed:.6f} сек")
        return result
    return wrapper


class Report:
    __slots__ = ("title", "columns", "_rows")

    def __init__(self, title: str, columns: list[str]) -> None:
        self.title: str = title
        self.columns: list[str] = columns
        self._rows: list[dict[str, str]] = []

    def add_row(self, row: dict[str, str]) -> None:
        if set(row.keys()) != set(self.columns):
            raise ValueError("Ключи строки не совпадают с колонками отчёта")
        new_row: dict[str, str] = {}
        for key, value in row.items():
            new_row[key] = value if isinstance(value, str) else str(value)
        self._rows.append(new_row)

    def rows(self) -> list[dict[str, str]]:
        return self._rows

    @property
    def rows_count(self) -> int:
        return len(self._rows)

    def __str__(self) -> str:
        cols = ", ".join(self.columns)
        return f"Отчёт '{self.title}' ({self.rows_count} строки, колонки: {cols})"

    def __repr__(self) -> str:
        return f"Report(title={self.title!r}, columns={self.columns!r})"


class IReportExporter(ABC):
    __slots__ = ()

    @abstractmethod
    def export(self, report: Report) -> str:
        ...


class JsonExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        data = {
            "title": report.title,
            "columns": report.columns,
            "rows": report.rows(),
        }
        return json.dumps(data, ensure_ascii=False, indent=2)


class CsvExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        lines = [";".join(report.columns)]
        for row in report.rows():
            lines.append(";".join(row[col] for col in report.columns))
        return "\n".join(lines)


class MarkdownExporter(IReportExporter):
    __slots__ = ()

    @log_calls
    def export(self, report: Report) -> str:
        header = "| " + " | ".join(report.columns) + " |"
        sep = "| " + " | ".join("---" for _ in report.columns) + " |"
        lines = [header, sep]
        for row in report.rows():
            lines.append("| " + " | ".join(row[col] for col in report.columns) + " |")
        return "\n".join(lines)


class Saver(Protocol):
    def save(self, path: str, content: str) -> None:
        ...


class FileSaver:
    __slots__ = ()

    def save(self, path: str, content: str) -> None:
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)


class ConsoleSaver:
    __slots__ = ()

    def save(self, path: str, content: str) -> None:
        print(content)


class MemorySaver:
    __slots__ = ("storage",)

    def __init__(self) -> None:
        self.storage: dict[str, str] = {}

    def save(self, path: str, content: str) -> None:
        self.storage[path] = content


class ReportPipeline:
    __slots__ = ("_exporter", "_saver")

    def __init__(self, exporter: IReportExporter, saver: Saver) -> None:
        self._exporter: IReportExporter = exporter
        self._saver: Saver = saver

    def run(self, report: Report, path: str) -> None:
        content = self._exporter.export(report)
        self._saver.save(path, content)


def main() -> None:
    report = Report("Продажи", ["date", "product", "amount"])
    report.add_row({"date": "2024-01-01", "product": "Яблоки", "amount": 10})
    report.add_row({"date": "2024-01-02", "product": "Бананы", "amount": "20"})
    report.add_row({"date": "2024-01-03", "product": "Апельсины", "amount": 30})
    report.add_row({"date": "2024-01-04", "product": "Груши", "amount": 40})
    report.add_row({"date": "2024-01-05", "product": "Киви", "amount": 50})

    print(report)
    print(repr(report))
    print(f"Всего строк: {report.rows_count}")

    print("\n=== JSON -> FileSaver ===")
    ReportPipeline(JsonExporter(), FileSaver()).run(report, "report.json")

    print("\n=== CSV -> ConsoleSaver ===")
    ReportPipeline(CsvExporter(), ConsoleSaver()).run(report, "report.csv")

    print("\n=== Markdown -> MemorySaver ===")
    memory_saver = MemorySaver()
    pipeline = ReportPipeline(MarkdownExporter(), memory_saver)
    pipeline.run(report, "report.md")
    print("Из MemorySaver:")
    print(memory_saver.storage["report.md"])

    print("\n=== Демонстрация работы декоратора log_calls ===")
    print("(см. вывод выше — перед каждым export печатается имя класса.метода и время)")


if __name__ == "__main__":
    main()