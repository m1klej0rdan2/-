if __name__ == "__main__":
    print("=== 1. Работа с классом Angle ===")
    a1 = Angle.from_degrees(90)
    a2 = Angle.from_radians(math.pi)
    print(f"Угол a1: {a1} | repr: {repr(a1)}")
    print(f"Угол a2: {a2} | repr: {repr(a2)}")

    # Геттеры и сеттеры
    a1.set_degrees(45)
    print(f"После изменения a1 (45°): в градусах = {a1.get_degrees():.1f}, в радианах = {a1.get_radians():.4f}")

    # Преобразование типов
    print(f"float(a2) = {float(a2)}, int(a2) = {int(a2)}")

    # Сравнение с учетом периодичности (30° и 390° равны)
    a3 = Angle.from_degrees(30)
    a4 = Angle.from_degrees(390)  # 360 + 30
    print(f"Сравнение с периодом: {a3} == {a4} -> {a3 == a4}")
    print(f"Сравнение: {a3} < {a2} -> {a3 < a2}")

    # Арифметика
    print(f"Сложение углов: {a3} + {a1} = {a3 + a1}")
    print(f"Сложение с числом (рад): {a3} + 1.0 = {a3 + 1.0}")
    print(f"Умножение и деление: {a1} * 2 = {a1 * 2}, {a2} / 2 = {a2 / 2}")

    print("\n=== 2. Работа с классом AngleRange ===")
    # Создание промежутков: [0°, 90°] и (45°, 180°)
    r1 = AngleRange(Angle.from_degrees(0), Angle.from_degrees(90), True, True)
    r2 = AngleRange(Angle.from_degrees(45), Angle.from_degrees(180), False, False)
    r3 = AngleRange(Angle.from_degrees(10), Angle.from_degrees(60), True, True)

    print(f"Промежуток r1: {r1}")
    print(f"Промежуток r2: {r2}")
    print(f"Длина r1 (в рад через abs): {abs(r1):.4f}, как объект Angle: {r1.length()}")

    # Сравнение промежутков
    print(f"r1 == r2: {r1 == r2}")
    print(f"r1 < r2 (по длине): {r1 < r2}")

    # Проверка операции in
    angle_45 = Angle.from_degrees(45)
    print(f"Угол 45° входит в r1 [0°, 90°]? -> {angle_45 in r1}")
    print(f"Угол 45° входит в r2 (45°, 180°)? -> {angle_45 in r2}")
    print(f"Промежуток r3 [10°, 60°] входит в r1 [0°, 90°]? -> {r3 in r1}")

    # Сложение и вычитание промежутков
    union_res = r1 + r2
    print(f"\nСложение r1 + r2: {[str(r) for r in union_res]}")

    diff_res1 = r1 - r2
    print(f"Вычитание r1 - r2 (остаток слева): {[str(r) for r in diff_res1]}")

    diff_res2 = r1 - r3
    print(f"Вычитание r1 - r3 (вырезание середины, 2 куска): {[str(r) for r in diff_res2]}")
