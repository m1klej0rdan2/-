if __name__ == "__main__":
    a1 = Angle.from_degrees(30)
    a2 = Angle.from_degrees(390)  # 360 + 30
    print("Углы:", a1, a2)
    print("Равны с учетом периода?", a1 == a2)
    print("Сложение:", a1 + Angle.from_degrees(60))
    print("Умножение:", a1 * 3)

    r1 = AngleRange(Angle.from_degrees(0), Angle.from_degrees(90))                # [0°, 90°]
    r2 = AngleRange(Angle.from_degrees(45), Angle.from_degrees(180), False, True) # (45°, 180°]
    r3 = AngleRange(Angle.from_degrees(20), Angle.from_degrees(50))               # [20°, 50°]

    print("\nПромежутки:", r1, "и", r2)
    print("Длина r1 в радианах:", round(abs(r1), 2))
    print("Угол 30° внутри r1?", a1 in r1)
    print("Промежуток r3 внутри r1?", r3 in r1)
    print("Сложение r1 + r2:", r1 + r2)
    print("Вычитание r1 - r3:", r1 - r3)
